+/* Kelley cutting planes on the three-dimensional convex price objective.
+ * The tiny LP only proposes prices: pruning always rechecks actual supports. */
+#define PRICE_LP_M 140
+#define PRICE_LP_N 6
+static double price_cuts[PRICE_LP_M][PRICE_LP_N+1];
+static double price_table[PRICE_LP_M+1][PRICE_LP_N+1];
+static int price_basic[PRICE_LP_M],price_nonbasic[PRICE_LP_N];
+static int price_lp(int m,double *solution){
+ const int n=PRICE_LP_N;
+ for(int i=0;i<m;i++){price_basic[i]=n+i;for(int j=0;j<=n;j++)price_table[i][j]=price_cuts[i][j];}
+ for(int j=0;j<n;j++){price_nonbasic[j]=j;price_table[m][j]=j==5?-1:0;solution[j]=0;}
+ price_table[m][n]=0;
+ for(int iteration=0;iteration<400;iteration++){
+  int s=-1;for(int j=0;j<n;j++)if(price_table[m][j]<-1e-11&&(s<0||price_nonbasic[j]<price_nonbasic[s]))s=j;
+  if(s<0){for(int i=0;i<m;i++)if(price_basic[i]<n)solution[price_basic[i]]=price_table[i][n];return 1;}
+  int r=-1;
+  for(int i=0;i<m;i++)if(price_table[i][s]>1e-12){
+   double ratio=price_table[i][n]/price_table[i][s];
+   if(r<0||ratio<price_table[r][n]/price_table[r][s]-1e-11||(__builtin_fabs(ratio-price_table[r][n]/price_table[r][s])<=1e-11&&price_basic[i]<price_basic[r]))r=i;
+  }
+  if(r<0)return 0;
+  double inverse=1/price_table[r][s];
+  for(int i=0;i<=m;i++)if(i!=r)for(int j=0;j<=n;j++)if(j!=s)price_table[i][j]-=price_table[r][j]*price_table[i][s]*inverse;
+  for(int j=0;j<=n;j++)if(j!=s)price_table[r][j]*=inverse;
+  for(int i=0;i<=m;i++)if(i!=r)price_table[i][s]*=-inverse;
+  price_table[r][s]=inverse;int t=price_basic[r];price_basic[r]=price_nonbasic[s];price_nonbasic[s]=t;
+ }
+ return 0;
+}
